# BlueChain Backend Environment Configuration
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/forms_db?retryWrites=true&w=majority

# Web3 / Blockchain Network Configuration
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY
TOKEN_CONTRACT_ADDRESS=0x37C2F87A762952Eae28fA6e6C41829eD197F4a85

# External Satellite Environmental Data Providers
# Supported providers: copernicus | sentinel-hub | earth-engine | openeo
SATELLITE_PROVIDER=copernicus
SATELLITE_API_KEY=
SATELLITE_API_URL=https://sh.dataspace.copernicus.eu/api/v1/process

# OCR & Document Text Extraction Providers
# Supported providers: tesseract | google-vision | aws-textract
OCR_PROVIDER=
OCR_API_KEY=

# Land Registry & Geographic Data Providers
LAND_DATA_PROVIDER=
LAND_DATA_API_KEY=

# AI Language Model Providers (for legal text extraction & document summarization)
AI_PROVIDER=
AI_API_KEY=
